{
    "name": "dnadesign/silverstripe-youtube-embed",
    "description": "Embeds a YouTube iframe in SilverStripe templates with an optional poster image field",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "youtube",
        "embed",
        "video"
    ],
    "require": {
        "toastnz/youtubefield": "dev-feature/silverstripe-6",
        "mobiledetect/mobiledetectlib": "^4"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dnadesign/silverstripe-youtubefield.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "DNADesign\\YoutubeEmbed\\": "src/"
        }
    },
    "extra": {
        "installer-name": "silverstripe-youtube-embed",
        "expose": [
            "client"
        ]
    },
    "license": "BSD-3-Clause"
}
